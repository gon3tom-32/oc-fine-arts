---
import Base from "../layouts/Base.astro";
import WhoToAsk from "../components/WhoToAsk.astro";
import site from "../content/site.json";
import { directionsLink } from "../lib/ics.js";
---

<Base title="Contact" current="contact" description="Who to ask about Art, Choir, and Musical Theater.">
  <section class="page-hero">
    <div class="wrap">
      <h1>Contact</h1>
      <p>Questions about fine arts at {site.schoolName}? Here is who to ask.</p>
    </div>
  </section>

  <div class="wrap contact-layout">
    <section class="card" aria-labelledby="teacher-heading">
      <h2 id="teacher-heading">{site.teacher.name}</h2>
      <p>{site.teacher.title}<br />Art, Choir, and Musical Theater</p>
      <p><a href={`mailto:${site.teacher.email}`}>{site.teacher.email}</a></p>
      <a class="btn" href={`mailto:${site.teacher.email}`}>Email the teacher</a>
    </section>
    <WhoToAsk headingLevel={2} />
    <section class="card" aria-labelledby="ps-heading">
      <h2 id="ps-heading">Announcements</h2>
      <p>News, reminders, and alerts go out on ParentSquare. This site is where to check dates and details.</p>
      <a class="btn btn-outline" href={site.parentSquareUrl}>Open ParentSquare</a>
    </section>
    <section class="card" aria-labelledby="campus-heading">
      <h2 id="campus-heading">Campuses</h2>
      <dl class="campuses">
        {
          site.campuses.map((campus) => (
            <div>
              <dt>{campus.name}</dt>
              <dd>
                {campus.address}
                <br />
                <a href={directionsLink(campus.address)} target="_blank" rel="noopener">
                  Get directions<span class="sr-only"> to the {campus.name} (opens in a new tab)</span>
                </a>
              </dd>
            </div>
          ))
        }
      </dl>
      <p>School office: <a href={`tel:${site.schoolPhone.replace(/[^\d+]/g, "")}`}>{site.schoolPhone}</a></p>
    </section>
  </div>
</Base>

<style>
  .contact-layout { display: grid; gap: 16px; }
  @media (min-width: 760px) { .contact-layout { grid-template-columns: 1fr 1fr; } }
  .contact-layout a { overflow-wrap: anywhere; }
  .campuses { margin: 0 0 12px; }
  .campuses div { padding: 8px 0; }
  .campuses dt { font-weight: 700; }
  .campuses dd { margin: 0; }
  .campuses a { display: inline-flex; align-items: center; min-height: var(--tap); font-weight: 700; }
</style>
