---
import site from "../content/site.json";
import { link } from "../lib/urls.js";
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <p>
      <strong>{site.departmentName}</strong> · {site.schoolName}
    </p>
    <p>
      Questions? <a href={link("contact/")}>Who to ask</a> · Announcements are on{" "}
      <a href={site.parentSquareUrl}>ParentSquare</a>
    </p>
    {site.motto && <p class="footer-motto">{site.motto}</p>}
    <p class="footer-note">{site.footerNote}</p>
  </div>
</footer>

<style>
  .site-footer { background: var(--wash); margin-top: 48px; padding: 28px 0; font-size: 0.95rem; }
  .footer-inner p { margin: 0 0 6px; }
  .footer-motto { font-style: italic; }
  .footer-note { color: var(--muted); }
</style>
